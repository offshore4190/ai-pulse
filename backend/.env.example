# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aipulse"

# ── AI ──────────────────────────────────────────────────────────────────────
# Google Gemini API key — used for translation, scoring, and enrichment.
# Reuse the same key as the frontend if desired.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Data Sources ────────────────────────────────────────────────────────────
# Twitter / X API v2 Bearer Token (required for Twitter collector).
# Get it from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN="YOUR_TWITTER_BEARER_TOKEN"

# YouTube Data API v3 key (required for YouTube collector).
# Get it from: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY="YOUR_YOUTUBE_API_KEY"

# GitHub Personal Access Token (optional — increases API rate limit from 60 to 5000 req/hr).
# Get it from: https://github.com/settings/tokens
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of additional frontend origins allowed to call the backend.
# Example: "https://ai-pulse.vercel.app,https://www.yourapp.com"
EXTRA_CORS_ORIGINS=""
