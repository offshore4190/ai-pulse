# ==========================================
# AI Pulse Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==========================================
# REQUIRED: Gemini API Key
# ==========================================
# Get your API key from: https://ai.google.dev/
# This is required for AI-powered content generation
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# OPTIONAL: Application URL
# ==========================================
# The URL where your app is deployed (for QR code generation, etc.)
# Examples:
#   - Vercel: https://ai-pulse.vercel.app
#   - Custom: https://your-domain.com
# Leave empty for local development
APP_URL=

# ==========================================
# OPTIONAL: Backend Pipeline URL
# ==========================================
# URL of the Python FastAPI backend pipeline service.
# When set, the frontend will fetch pre-built snapshots from the backend
# before falling back to direct Gemini API calls (saves API quota).
# Leave empty to disable the backend fast-path and use direct Gemini calls.
# Examples:
#   - Local:      http://localhost:8000
#   - Production: https://your-pipeline-backend.com
VITE_PIPELINE_API_URL=

# ==========================================
# GitHub Actions Secrets (for CI/CD)
# ==========================================
# These should be set in GitHub repository secrets, NOT in .env
# - GEMINI_API_KEY: For daily snapshot generation
# - APP_URL: For QR code generation in snapshots
# - VERCEL_TOKEN: For automated Vercel deployments (optional)
